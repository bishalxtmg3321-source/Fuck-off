<!DOCTYPE html>
<html>
<head>
  <title>My Website</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f2f5ff;
      text-align: center;
    }

    .header {
      background: #4f46e5;
      color: white;
      padding: 30px 15px;
    }

    .header h1 {
      margin: 0;
      font-size: 35px;
    }

    .card {
      background: white;
      margin: 40px 20px;
      padding: 30px 20px;
      border-radius: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    }

    .button {
      display: inline-block;
      background: #4f46e5;
      color: white;
      padding: 14px 25px;
      border-radius: 30px;
      text-decoration: none;
      margin-top: 15px;
    }

    .button:hover {
      background: #3730a3;
    }

    footer {
      margin-top: 50px;
      padding: 20px;
      background: #111827;
      color: white;
    }
  </style>
</head>

<body>

  <div class="header">
    <h1>My Website 🚀</h1>
    <p>Welcome to my first website!</p>
  </div>

  <div class="card">
    <h2>Hello! 👋</h2>
    <p>
      My name is Bishal. This is my first website
      made with HTML and CSS.
    </p>

    <a href="#" class="button">Click Me</a>
  </div>

  <footer>
    © 2026 My Website
  </footer>

</body>
</html>
